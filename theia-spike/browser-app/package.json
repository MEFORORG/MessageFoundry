{
  "private": true,
  "name": "messagefoundry-theia-spike-browser-app",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "MessageFoundry Steps (spike S-2)",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "dependencies": {
    "@messagefoundry/theia-steps-spike": "0.0.0",
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@theia/cli": "1.76.0",
    "@theia/playwright": "1.76.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "start": "theia start --hostname 127.0.0.1 --port 3030",
    "test:e2e": "playwright test"
  }
}
