{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "rootDir": "../..",
    "outDir": "lib",
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["src", "../../ide/src/stepsModel.ts"]
}
