messagefoundry_oldest_pending_age_seconds{connection="IB_ACME_ADT",destination="IB_q\"uote\\back\nline-é"} -0.5
# HELP messagefoundry_outbox_status Current count of outbound rows by status.
# TYPE messagefoundry_outbox_status gauge
messagefoundry_outbox_status{status="pending"} 3.0
messagefoundry_outbox_status{status="dead"} 1.0
# HELP messagefoundry_in_pipeline Current not-done rows across every stage (ingress + routed + outbound).
# TYPE messagefoundry_in_pipeline gauge
messagefoundry_in_pipeline 7.0
# HELP messagefoundry_store_committed_txns_total Physical store transactions committed (process lifetime).
# TYPE messagefoundry_store_committed_txns_total counter
messagefoundry_store_committed_txns_total 1.23456789e+08
# HELP messagefoundry_store_body_copies_total Raw/payload body strings durably written to the store (process lifetime).
# TYPE messagefoundry_store_body_copies_total counter
messagefoundry_store_body_copies_total 0.0
# HELP messagefoundry_store_fenced_writes_total Terminal queue resolves rejected by the leader-epoch fence (process lifetime).
# TYPE messagefoundry_store_fenced_writes_total counter
messagefoundry_store_fenced_writes_total 1.0
# HELP messagefoundry_store_claim_proc_effective 1 when the ADR 0114 stored-procedure claim path passed its startup gate and is active, 0 when it degraded to the shipped ad-hoc batch (claims still flow).
# TYPE messagefoundry_store_claim_proc_effective gauge
messagefoundry_store_claim_proc_effective 1.0
# HELP messagefoundry_store_claim_proc_head_verbatim 1 when at least one deployed claim procedure's stored definition kept the CREATE OR ALTER head verbatim (this server does not rewrite it), else 0.
# TYPE messagefoundry_store_claim_proc_head_verbatim gauge
messagefoundry_store_claim_proc_head_verbatim 1.0
# HELP messagefoundry_store_pool_max_connections Configured maximum size of the store connection pool.
# TYPE messagefoundry_store_pool_max_connections gauge
messagefoundry_store_pool_max_connections 10.0
# HELP messagefoundry_store_pool_open_connections Connections currently open in the store pool.
# TYPE messagefoundry_store_pool_open_connections gauge
messagefoundry_store_pool_open_connections 10.0
# HELP messagefoundry_store_pool_idle_connections Currently-free (idle) connections in the store pool.
# TYPE messagefoundry_store_pool_idle_connections gauge
messagefoundry_store_pool_idle_connections 0.0
# HELP messagefoundry_store_pool_saturated 1 when the store pool has zero idle connections (saturated), else 0.
# TYPE messagefoundry_store_pool_saturated gauge
messagefoundry_store_pool_saturated 1.0
# HELP messagefoundry_store_pool_acquire_wait_p50_seconds Store pool acquire() wait p50 (seconds) since process start.
# TYPE messagefoundry_store_pool_acquire_wait_p50_seconds gauge
messagefoundry_store_pool_acquire_wait_p50_seconds 0.0015
# HELP messagefoundry_store_pool_acquire_wait_p95_seconds Store pool acquire() wait p95 (seconds) since process start.
