messagefoundry_http_sync_reply_waiters{connection="IB_HTTP"} 3.0
messagefoundry_http_sync_reply_waiters{connection="IB_q\"uote\\back\nline-é"} 0.0
# HELP messagefoundry_messages_errored_total Messages that failed intake/validation on an inbound connection (process lifetime).
# TYPE messagefoundry_messages_errored_total counter
messagefoundry_messages_errored_total{connection="IB_ACME_ADT"} 0.0
messagefoundry_messages_errored_total{connection="IB_q\"uote\\back\nline-é"} 1.0
