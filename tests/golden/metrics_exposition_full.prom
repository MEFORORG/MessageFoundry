# HELP messagefoundry_build_info Build metadata; constant 1, version carried as a label.
# TYPE messagefoundry_build_info gauge
messagefoundry_build_info{version="0.4.0+\"build\"\\x\n"} 1.0
# HELP messagefoundry_host_cpu_percent Host-wide CPU utilization percent (0-100) since the previous scrape.
# TYPE messagefoundry_host_cpu_percent gauge
messagefoundry_host_cpu_percent NaN
# HELP messagefoundry_host_memory_used_bytes Host physical memory in use (total - available), bytes.
# TYPE messagefoundry_host_memory_used_bytes gauge
messagefoundry_host_memory_used_bytes 1.6e+10
# HELP messagefoundry_host_memory_total_bytes Host total physical memory, bytes.
# TYPE messagefoundry_host_memory_total_bytes gauge
messagefoundry_host_memory_total_bytes 1.234567e+06
# HELP messagefoundry_process_resident_memory_bytes Resident set size (RSS) of the engine process, bytes.
# TYPE messagefoundry_process_resident_memory_bytes gauge
messagefoundry_process_resident_memory_bytes 0.5
# HELP messagefoundry_messages_received_total Messages received on an inbound connection (process lifetime).
# TYPE messagefoundry_messages_received_total counter
messagefoundry_messages_received_total{connection="IB_ACME_ADT"} 12.0
messagefoundry_messages_received_total{connection="IB_q\"uote\\back\nline-é"} 3.0
# HELP messagefoundry_http_sync_replies_total Synchronous captured-downstream replies resolved, by outcome (process lifetime).
# TYPE messagefoundry_http_sync_replies_total counter
messagefoundry_http_sync_replies_total{connection="IB_HTTP",status="degraded"} 1.0
messagefoundry_http_sync_replies_total{connection="IB_HTTP",status="reply"} 7.0
messagefoundry_http_sync_replies_total{connection="IB_HTTP",status="timeout"} 2.0
# HELP messagefoundry_http_sync_reply_wait_seconds Mean time an HTTP turn blocked on a captured downstream reply (process lifetime). Answers 'is this approaching reply_timeout?' before the pager does.
# TYPE messagefoundry_http_sync_reply_wait_seconds gauge
messagefoundry_http_sync_reply_wait_seconds{connection="IB_HTTP"} 0.5
messagefoundry_http_sync_reply_wait_seconds{connection="IB_q\"uote\\back\nline-é"} 0.0
# HELP messagefoundry_http_sync_reply_waiters HTTP turns currently blocked on a captured downstream reply.
